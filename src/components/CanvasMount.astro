---
/**
 * Reproduces the DOM that react-three-fiber's <Canvas> emitted in the original
 * build: an outer positioned wrapper, an inner sizing div, and the canvas.
 * The `scene` attribute tells the client renderer which scene to attach.
 */
export interface Props {
  scene: string;
}

const { scene } = Astro.props;
---

<div style="position:relative;width:100%;height:100%;overflow:hidden;pointer-events:auto">
  <div style="width:100%;height:100%">
    <canvas style="display:block" data-scene={scene}></canvas>
  </div>
</div>
